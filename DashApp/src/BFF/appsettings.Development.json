{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "vite": {
        "ClusterId": "vite",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "vite": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5173"
          }
        }
      }
    }
  }
}
